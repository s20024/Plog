---
import Layout from '../../layouts/BaseLayout.astro';
import Plogs from '../../components/Plogs.astro';
import SearchForm from '../../components/search/SearchForm';
---

<Layout title="Plog記事一覧">
  <div class="container">
    <div class="page-header">
      <h1>Plog記事</h1>
      <p>プログラミングや開発に関する記事を書いています。</p>
    </div>

    <div class="plog-search">
      {/* memo: プログ一覧からの検索のため、検索ページをプログで絞り込んだ状態で開く。 */}
      <SearchForm category="plog" placeholder="プログ内を検索" />
    </div>

    {/* memo: トップページの「最新のPlog」と同じ一覧(幅・列数)で全件を表示する。 */}
    <Plogs />
  </div>
</Layout>

<style lang="scss">
  .page-header {
    text-align: center;
    margin: 2rem 0 2rem;

    h1 {
      font-size: 2.5rem;
      margin-bottom: 0.5rem;
      background: linear-gradient(45deg, var(--base-color), var(--sub-color-1), var(--sub-color-4));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      display: inline-block;
    }

    p {
      font-size: 1.2rem;
      opacity: 0.8;
    }
  }

  .plog-search {
    max-width: 600px;
    margin: 0 auto 3rem;
  }
</style>
